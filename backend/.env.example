# ============================================
# 视频自动化工作台 — API 密钥配置
# 开发模式：将此文件复制为 .env 并填入你自己的密钥
# 打包模式：将 exe 同目录下的 .env.example 重命名为 .env 并填入密钥
# ============================================

# DeepSeek API（文本改写/LLM清洗/句切分/语义安全改写）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# TikHub API（抖音视频解析，备选通道）
# 获取地址：https://api.tikhub.io/
TIKHUB_API_KEY=你的TikHub密钥

# SiliconFlow API（语音识别 ASR + TTS 音色克隆）
# 获取地址：https://siliconflow.cn/ →  API 密钥
SILICONFLOW_API_KEY=sk-你的SiliconFlow密钥

# 火山引擎访问令牌（豆包 TTS 配音）
# 获取地址：https://console.volcengine.com/ →  语音技术
VOLC_ACCESS_TOKEN=你的火山引擎Token

# 火山引擎 ARK API Key（豆包 TTS v3）
# 获取地址：https://console.volcengine.com/ark/ →  API Keys
ARK_API_KEY=你的ARK密钥

# Fal.ai API Key（AI 配图生成）
# 获取地址：https://fal.ai/dashboard →  Settings →  API Keys
FAL_KEY=你的Fal密钥

# Fal.ai 画质（low / medium / high）
FAL_QUALITY=low
